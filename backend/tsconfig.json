{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "strict": false,
    "noEmit": true,
    "moduleResolution": "node"
  },
  "include": ["**/*.js"],
  "exclude": ["node_modules", "UPLOADS", "coverage"]
}